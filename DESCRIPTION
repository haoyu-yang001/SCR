Package: SCR
Title: Sequential Covariate-Adjusted Randomization
Version: 2.0.0
Authors@R: c(
    person("Haoyu", "Yang", email = "haoyuyang@hsph.harvard.edu", role = c("aut", "cre")),
    person("Yichen", "Qin", email = "qinyn@ucmail.uc.edu", role = "aut"),
    person("Yang", "Li", email = "yang.li@ruc.edu.cn", role = "aut"),
    person("Feifang", "Hu", role = "aut"),
    person("Fanglu", "Chen", email = "chenfanglu1031@qq.com", role = "aut",
           comment = "original implementation in SCR 1.0.0")
